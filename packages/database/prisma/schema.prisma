generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Enums — kept in lockstep with packages/shared/src/enums/*.ts and
// packages/shared/src/permissions/index.ts. If you change a value here,
// change it there too.
// =============================================================================

enum StaffRole {
  OWNER
  ADMIN
  PAYMENT_REVIEWER
  SUPPORT_AGENT
  DELIVERY_AGENT
}

enum StaffStatus {
  ACTIVE
  DISABLED
}

enum CustomerStatus {
  ACTIVE
  BANNED
}

enum CategoryStatus {
  ACTIVE
  HIDDEN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductVisibility {
  VISIBLE
  HIDDEN
}

/// How a product is delivered. Fully admin-configurable per product — never hardcoded.
enum DeliveryType {
  AUTOMATIC
  MANUAL
  LICENSE_KEY
  ACCOUNT
  VOUCHER
  CODE
  CUSTOM
}

/// What kind of digital good the product represents.
enum FulfillmentType {
  ACCOUNT
  KEY
  CDK
  VOUCHER
  SUBSCRIPTION
  DIGITAL_FILE
  MANUAL_SERVICE
  CUSTOM
}

/// Whether inventory is tracked as a bare quantity or as individual secret-bearing units.
enum InventoryMode {
  QUANTITY
  INDIVIDUAL
}

enum InventoryItemStatus {
  AVAILABLE
  RESERVED
  SOLD
  DELIVERED
  DISABLED
}

enum OrderStatus {
  CREATED
  PENDING_PAYMENT
  PAYMENT_SUBMITTED
  PAYMENT_REVIEW
  PAID
  PROCESSING
  READY_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
  DISPUTED
}

enum OrderEventType {
  STATUS_CHANGED
  NOTE_ADDED
  PAYMENT_PROOF_UPLOADED
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  INVENTORY_RESERVED
  INVENTORY_RELEASED
  DELIVERY_STARTED
  DELIVERY_COMPLETED
  DELIVERY_FAILED
}

enum ActorType {
  CUSTOMER
  STAFF
  SYSTEM
}

enum PaymentProofStatus {
  PENDING
  APPROVED
  REJECTED
}

/// How a given order item actually got fulfilled. Derived from the
/// product's DeliveryType + InventoryMode at fulfillment time (see
/// DeliveryService.resolveMethod), not stored on the product — a product
/// configured AUTOMATIC but backed by QUANTITY stock has no secret to hand
/// over, so it resolves to MANUAL rather than silently delivering nothing.
enum DeliveryMethod {
  AUTOMATIC
  MANUAL
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  WAITING_ADMIN
  RESOLVED
  CLOSED
}

enum TicketCategory {
  ORDER_ISSUE
  PAYMENT_ISSUE
  DELIVERY_ISSUE
  PRODUCT_QUESTION
  ACCOUNT_ISSUE
  OTHER
}

enum TelegramUpdateStatus {
  PROCESSING
  COMPLETED
  FAILED
}

// =============================================================================
// Staff / RBAC
// =============================================================================

model Staff {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  name         String
  role         StaffRole
  status       StaffStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  refreshTokens    StaffRefreshToken[]
  reviewedProofs   PaymentProof[]      @relation("ProofReviewedBy")
  assignedTickets  SupportTicket[]     @relation("TicketAssignedTo")
  authoredMessages TicketMessage[]     @relation("MessageAuthorStaff")
  orderEvents      OrderEvent[]        @relation("OrderEventActorStaff")
  fulfilledDeliveries Delivery[]       @relation("DeliveryFulfilledBy")
  auditLogs        AuditLog[]
  updatedSettings  PlatformSetting[]

  @@map("staff")
}

model StaffRefreshToken {
  id        String    @id @default(uuid())
  staffId   String
  staff     Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([staffId])
  @@map("staff_refresh_tokens")
}

// =============================================================================
// Customers
// =============================================================================

model Customer {
  id               String         @id @default(uuid())
  telegramId       BigInt         @unique
  telegramUsername String?
  firstName        String?
  lastName         String?
  languageCode     String?
  status           CustomerStatus @default(ACTIVE)
  lastSeenAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  orders         Order[]
  paymentProofs  PaymentProof[]
  supportTickets SupportTicket[]
  ticketMessages TicketMessage[] @relation("MessageAuthorCustomer")
  orderEvents    OrderEvent[]    @relation("OrderEventActorCustomer")

  @@map("customers")
}

// =============================================================================
// Catalog
// =============================================================================

model Category {
  id           String         @id @default(uuid())
  slug         String         @unique
  name         String
  description  String?
  image        String?
  parentId     String?
  parent       Category?      @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]     @relation("CategoryTree")
  displayOrder Int            @default(0)
  status       CategoryStatus @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id                     String            @id @default(uuid())
  slug                   String            @unique
  name                   String
  shortDescription       String?
  description            String?
  categoryId             String?
  category               Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images                 String[]          @default([])
  price                  Decimal           @db.Decimal(12, 2)
  compareAtPrice         Decimal?          @db.Decimal(12, 2)
  currency               String            @default("USD")
  duration               String?
  warranty               String?
  stock                  Int               @default(0)
  inventoryMode          InventoryMode     @default(QUANTITY)
  deliveryType           DeliveryType
  fulfillmentType        FulfillmentType
  activationInstructions String?
  status                 ProductStatus     @default(DRAFT)
  visibility             ProductVisibility @default(HIDDEN)
  featured               Boolean           @default(false)
  tags                   String[]          @default([])
  metadata               Json?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  inventoryItems InventoryItem[]
  orderItems     OrderItem[]

  @@index([status, visibility, categoryId])
  @@index([featured])
  @@map("products")
}

// =============================================================================
// Inventory — individual secret-bearing units (accounts, keys, vouchers, ...).
// For INDIVIDUAL-mode products, available stock is COUNT(status = AVAILABLE),
// never a separately-stored counter, so it can't drift from reality.
// =============================================================================

model InventoryItem {
  id               String              @id @default(uuid())
  productId        String
  product          Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  encryptedPayload String
  status           InventoryItemStatus @default(AVAILABLE)
  reservedAt       DateTime?
  soldAt           DateTime?
  deliveredAt      DateTime?
  disabledReason   String?
  orderId          String?
  order            Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([productId, status])
  @@index([orderId])
  @@map("inventory_items")
}

// =============================================================================
// Orders
// =============================================================================

model Order {
  id              String         @id @default(uuid())
  sequenceNumber  Int            @unique @default(autoincrement())
  customerId      String
  customer        Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status          OrderStatus    @default(CREATED)
  currency        String         @default("USD")
  subtotal        Decimal        @db.Decimal(12, 2)
  total           Decimal        @db.Decimal(12, 2)
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  idempotencyKey  String
  cancelReason    String?
  paidAt          DateTime?
  deliveredAt     DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  items          OrderItem[]
  events         OrderEvent[]
  paymentProofs  PaymentProof[]
  inventoryItems InventoryItem[]
  supportTickets SupportTicket[]
  deliveries     Delivery[]

  @@unique([customerId, idempotencyKey])
  @@index([customerId, status])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id                      String          @id @default(uuid())
  orderId                 String
  order                   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId               String
  product                 Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  productNameSnapshot     String
  deliveryTypeSnapshot    DeliveryType
  fulfillmentTypeSnapshot FulfillmentType
  unitPrice               Decimal         @db.Decimal(12, 2)
  quantity                Int
  createdAt               DateTime        @default(now())

  delivery Delivery?

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderEvent {
  id              String         @id @default(uuid())
  orderId         String
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type            OrderEventType
  fromStatus      OrderStatus?
  toStatus        OrderStatus?
  actorType       ActorType
  actorStaffId    String?
  actorStaff      Staff?         @relation("OrderEventActorStaff", fields: [actorStaffId], references: [id], onDelete: SetNull)
  actorCustomerId String?
  actorCustomer   Customer?      @relation("OrderEventActorCustomer", fields: [actorCustomerId], references: [id], onDelete: SetNull)
  note            String?
  metadata        Json?
  createdAt       DateTime       @default(now())

  @@index([orderId])
  @@map("order_events")
}

/// One fulfillment record per order item. `encryptedContent` uses the same
/// AES-256-GCM wire format as InventoryItem.encryptedPayload, so delivered
/// credentials are never at rest in plaintext. The unique constraint on
/// orderItemId is what makes re-running a delivery job a no-op instead of a
/// second delivery.
model Delivery {
  id                 String         @id @default(uuid())
  orderId            String
  order              Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId        String         @unique
  orderItem          OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  inventoryItemIds   String[]       @default([])
  method             DeliveryMethod
  status             DeliveryStatus @default(PENDING)
  encryptedContent   String?
  note               String?
  attempts           Int            @default(0)
  lastError          String?
  deliveredAt        DateTime?
  deliveredByStaffId String?
  deliveredByStaff   Staff?         @relation("DeliveryFulfilledBy", fields: [deliveredByStaffId], references: [id], onDelete: SetNull)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([orderId])
  @@index([status, method])
  @@map("deliveries")
}

// =============================================================================
// Payments
// =============================================================================

model PaymentMethod {
  id            String   @id @default(uuid())
  name          String
  description   String?
  accountNumber String?
  instructions  String?
  qrCodeUrl     String?
  currency      String   @default("USD")
  enabled       Boolean  @default(true)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders Order[]

  @@map("payment_methods")
}

model PaymentProof {
  id              String             @id @default(uuid())
  orderId         String
  order           Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  telegramFileId  String?
  storageKey      String
  mimeType        String
  fileSize        Int
  status          PaymentProofStatus @default(PENDING)
  rejectionReason String?
  internalNote    String?
  reviewedById    String?
  reviewedBy      Staff?             @relation("ProofReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  uploadedAt      DateTime           @default(now())

  @@index([orderId, status])
  @@index([status])
  @@map("payment_proofs")
}

// =============================================================================
// Support
// =============================================================================

model SupportTicket {
  id              String         @id @default(uuid())
  ticketNumber    Int            @unique @default(autoincrement())
  customerId      String
  customer        Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  subject         String
  category        TicketCategory @default(OTHER)
  status          TicketStatus   @default(OPEN)
  orderId         String?
  order           Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  assignedStaffId String?
  assignedStaff   Staff?         @relation("TicketAssignedTo", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  /// Unread counters are maintained atomically alongside message inserts
  /// (increment for the other side, reset to 0 for the author's side), so a
  /// badge count never needs a COUNT(*) over messages on every list call.
  customerUnread  Int            @default(0)
  staffUnread     Int            @default(0)
  lastMessageAt   DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  closedAt        DateTime?

  messages TicketMessage[]

  @@index([customerId, status])
  @@index([status])
  @@map("support_tickets")
}

model TicketMessage {
  id               String        @id @default(uuid())
  ticketId         String
  ticket           SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorType       ActorType
  authorStaffId    String?
  authorStaff      Staff?        @relation("MessageAuthorStaff", fields: [authorStaffId], references: [id], onDelete: SetNull)
  authorCustomerId String?
  authorCustomer   Customer?     @relation("MessageAuthorCustomer", fields: [authorCustomerId], references: [id], onDelete: SetNull)
  message          String
  attachments      Json?
  internal         Boolean       @default(false)
  createdAt        DateTime      @default(now())

  @@index([ticketId])
  @@map("ticket_messages")
}

// =============================================================================
// Platform-wide config (admin-managed, avoids hardcoded settings)
// =============================================================================

model PlatformSetting {
  key              String   @id
  value            Json
  updatedAt        DateTime @updatedAt
  updatedByStaffId String?
  updatedByStaff   Staff?   @relation(fields: [updatedByStaffId], references: [id], onDelete: SetNull)

  @@map("platform_settings")
}

// =============================================================================
// Audit trail (admin/staff mutations)
// =============================================================================

model AuditLog {
  id           String   @id @default(uuid())
  actorStaffId String?
  actorStaff   Staff?   @relation(fields: [actorStaffId], references: [id], onDelete: SetNull)
  action       String
  entityType   String
  entityId     String
  changes      Json?
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================================================
// Telegram webhook idempotency ledger (second line of defense behind Redis SETNX)
// =============================================================================

model TelegramUpdateLog {
  id          String               @id @default(uuid())
  updateId    BigInt               @unique
  status      TelegramUpdateStatus @default(PROCESSING)
  error       String?
  receivedAt  DateTime             @default(now())
  processedAt DateTime?

  @@map("telegram_update_log")
}
