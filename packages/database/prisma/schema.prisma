model AuditLog {
  id           String   @id @default(uuid())
  actorStaffId String?
  actorStaff   Staff?   @relation(fields: [actorStaffId], references: [id], onDelete: SetNull)
  action       String
  entityType   String
  entityId     String
  changes      Json?
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
