enum MemberDiscountKind {
  /// Standing discount for a customer who has completed a paid order.
  VERIFIED
  /// One-time first-order gift for a customer who has not bought yet.
  WELCOME
  /// Standing discount for a pre-platform customer matched by phone.
  LEGACY
}

enum CouponType {
  /// `value` is a percentage of the subtotal, 1–100.
  PERCENT
  /// `value` is a flat amount in the store's currency.
  FIXED
}

/// A redeemable discount code.
///
/// Every limit is optional except the per-customer one, so the same model
/// covers a public launch code, a one-off apology to a single customer, and
/// a capped campaign — without three tables or a `kind` column that changes
/// what the other fields mean.
model Coupon {
  id    String     @id @default(uuid())
  /// Always stored upper-cased; lookups upper-case the input to match, so
  /// "welcome10" and "WELCOME10" are the same code and cannot both exist.
  code  String     @unique
  type  CouponType
  value Decimal    @db.Decimal(12, 2)

  /// Orders under this subtotal cannot use the code.
  minSubtotal      Decimal? @db.Decimal(12, 2)
  /// PERCENT only: the ceiling on what a large order can take off.
  maxDiscount      Decimal? @db.Decimal(12, 2)
  /// Total redemptions across everyone. NULL means unlimited.
  maxRedemptions   Int?
  /// How many times one customer may use it.
  perCustomerLimit Int      @default(1)

  startsAt DateTime?
  endsAt   DateTime?
  active   Boolean   @default(true)

  /// Denormalised count, incremented under the same guard that inserts the
  /// redemption, so the global cap can be enforced without counting rows.
  timesRedeemed Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions CouponRedemption[]
  orders      Order[]

  @@index([active, endsAt])
  @@map("coupons")
}

/// One coupon use. The unique on orderId is what makes redemption
/// exactly-once: a retried checkout cannot spend the same code twice.
model CouponRedemption {
  id          String   @id @default(uuid())
  couponId    String
  coupon      Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// What this particular redemption was worth, for reporting.
  amount      Decimal  @db.Decimal(12, 2)
  /// This customer's ordinal use of this coupon (highest so far + 1).
  /// Counting rows and then inserting would let two concurrent checkouts
  /// both see "used 0 times"; making the ordinal part of a unique index
  /// means the loser of that race hits a constraint instead of a second
  /// free discount. Not count + 1: a cancelled order hands its use back by
  /// deleting its row, which can leave a gap below the highest ordinal.
  customerSeq Int
  createdAt   DateTime @default(now())

  @@unique([couponId, customerId, customerSeq])
  @@index([couponId, customerId])
  @@map("coupon_redemptions")
}

// =============================================================================
// Product Reviews & Testimonials
// =============================================================================

model ProductReview {
  id             String   @id @default(uuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId        String   @unique
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Rating: 1-5 stars
  rating         Int
  /// Review title (e.g., "Great product!")
  title          String?
  /// Detailed comment/testimonial
  comment        String?
  /// Attached images/video URLs
  attachmentUrls String[]
  /// Only verified: reviews from completed paid orders
  verified       Boolean  @default(false)
  /// Helpful votes
  helpful        Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([productId])
  @@index([customerId])
  @@index([rating])
  @@index([verified])
  @@map("product_reviews")
}

// =============================================================================
// Social Reward Claims (Facebook comment/rating)
// =============================================================================

model SocialRewardClaim {
  id                 String    @id @default(uuid())
  productId          String
  product            Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId         String
  customer           Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Claim type: FACEBOOK_COMMENT or FACEBOOK_RATING
  claimType          String
  /// URL to the Facebook post they commented on
  facebookPostUrl    String?
  /// URL to their Facebook profile
  facebookProfileUrl String?
  /// Screenshots proving they completed the action
  proofScreenshots   String[]
  /// Status: PENDING, APPROVED, REJECTED
  status             String    @default("PENDING")
  /// Staff member who reviewed
  reviewedBy         String?
  reviewedByStaff    Staff?    @relation(fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt         DateTime?
  rejectionReason    String?
  /// Order created after approval (gift)
  orderId            String?   @unique
  order              Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([productId])
  @@index([customerId])
  @@index([status])
  @@map("social_reward_claims")
}

// =============================================================================
// Product Variants (size, color, tier options)
// =============================================================================

model ProductVariant {
  id            String   @id @default(uuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Variant name (e.g., "Small", "Red", "Pro Tier")
  name          String
  /// SKU for inventory tracking
  sku           String
  /// Additional price modifier (e.g., +$5 for larger size)
  priceModifier Decimal? @db.Decimal(12, 2)
  /// Stock count for this variant
  stock         Int      @default(0)
  /// Sort order in product UI
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([productId, sku])
  @@index([productId])
  @@map("product_variants")
}

// =============================================================================
// Customer Notifications — in-app notification inbox for customers.
// =============================================================================

model CustomerNotification {
  id         String    @id @default(uuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Notification kind, e.g. "order.status_changed", "payment.approved"
  kind       String
  title      String
  body       String
  metadata   Json?
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId, isRead])
  @@map("customer_notifications")
}

// =============================================================================
// Quantity bundles — "5 accounts for less than 5 × the single price".
// =============================================================================

model ProductBundle {
  id            String   @id @default(uuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Shown on the option, e.g. "باقة 5 حسابات". Falls back to "{quantity} ×".
  label         String?
  quantity      Int
  /// The price of the whole bundle, not per unit.
  price         Decimal  @db.Decimal(12, 2)
  /// Only approved wholesale members see and can buy this bundle.
  wholesaleOnly Boolean  @default(false)
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orderItems OrderItem[]

  @@index([productId, active])
  @@map("product_bundles")
}

// =============================================================================
// Abuse control — strikes, temporary suspensions and appeals.
// =============================================================================

/// One suspicious event. Strikes inside the ladder window escalate:
/// short suspension, long suspension, then a permanent ban.
model CustomerStrike {
  id             String    @id @default(uuid())
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// DUPLICATE_PROOF, PROOF_REJECTED, PROOF_ATTEMPTS, ORDER_SPAM, MANUAL
  source         String
  reason         String
  /// SUSPEND or BAN — what this strike did.
  action         String
  suspendedUntil DateTime?
  createdAt      DateTime  @default(now())

  @@index([customerId, createdAt])
  @@map("customer_strikes")
}

enum AppealStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model CustomerAppeal {
  id           String       @id @default(uuid())
  customerId   String
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  message      String
  status       AppealStatus @default(PENDING)
  response     String?
  reviewedById String?
  reviewedBy   Staff?       @relation("AppealReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())

  @@index([status, createdAt])
  @@index([customerId])
  @@map("customer_appeals")
}

// =============================================================================
// Wholesale membership
// =============================================================================

enum WholesaleStatus {
  PENDING
  APPROVED
  REJECTED
}

model WholesaleApplication {
  id              String          @id @default(uuid())
  customerId      String
  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  businessName    String
  contactPhone    String
  /// Free text: "50 حساب شهرياً", "Canva + ChatGPT"...
  monthlyVolume   String?
  notes           String?
  termsAcceptedAt DateTime
  status          WholesaleStatus @default(PENDING)
  staffNote       String?
  reviewedById    String?
  reviewedBy      Staff?          @relation("WholesaleReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([customerId])
  @@map("wholesale_applications")
}

enum WalletEntryType {
  TOPUP
  PURCHASE
  REFUND
  ADJUSTMENT
}

enum WalletTopUpStatus {
  PENDING
  APPROVED
  REJECTED
}

/// One movement of a customer's wallet balance. Append-only: the balance
/// on Customer always equals the sum of these, and `balanceAfter` lets
/// anyone audit the running total line by line.
model WalletEntry {
  id           String          @id @default(uuid())
  customerId   String
  customer     Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type         WalletEntryType
  /// Signed: credits are positive, debits negative.
  amount       Decimal         @db.Decimal(12, 2)
  balanceAfter Decimal         @db.Decimal(12, 2)
  currency     String
  orderId      String?
  order        Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  topUpId      String?         @unique
  topUp        WalletTopUp?    @relation(fields: [topUpId], references: [id], onDelete: SetNull)
  staffId      String?
  staff        Staff?          @relation("WalletEntryStaff", fields: [staffId], references: [id], onDelete: SetNull)
  note         String?
  createdAt    DateTime        @default(now())

  @@index([customerId, createdAt])
  @@index([orderId])
  @@map("wallet_entries")
}

/// A merchant's request to add money to their wallet: the transfer
/// receipt, reviewed by staff like an order's payment proof.
model WalletTopUp {
  id              String            @id @default(uuid())
  customerId      String
  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Credited on approval, in `currency` (the store's default currency).
  amount          Decimal           @db.Decimal(12, 2)
  currency        String
  paymentMethodId String?
  paymentMethod   PaymentMethod?    @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  /// What the merchant actually transferred, frozen with its rate.
  payCurrency     String?
  payAmount       Decimal?          @db.Decimal(14, 2)
  exchangeRate    Decimal?          @db.Decimal(14, 6)
  storageKey      String
  mimeType        String
  contentHash     String
  senderReference String?
  status          WalletTopUpStatus @default(PENDING)
  reviewedById    String?
  reviewedBy      Staff?            @relation("TopUpReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  rejectReason    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  entry WalletEntry?

  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([contentHash])
  @@map("wallet_top_ups")
}
