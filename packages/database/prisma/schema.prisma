model PlatformSetting {
  key              String   @id
  value            Json
  updatedAt        DateTime @updatedAt
  updatedByStaffId String?
  updatedByStaff   Staff?   @relation(fields: [updatedByStaffId], references: [id], onDelete: SetNull)

  @@map("platform_settings")
}

