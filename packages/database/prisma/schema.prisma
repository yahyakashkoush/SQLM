// =============================================================================
// Telegram webhook idempotency ledger (second line of defense behind Redis SETNX)
// =============================================================================

model TelegramUpdateLog {
  id          String               @id @default(uuid())
  updateId    BigInt               @unique
  status      TelegramUpdateStatus @default(PROCESSING)
  error       String?
  receivedAt  DateTime             @default(now())
