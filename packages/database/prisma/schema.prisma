// Placeholder schema for Phase 1 tooling verification.
// The full domain model is authored in Phase 2 — see docs/PHASES.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model HealthCheck {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  @@map("health_checks")
}
